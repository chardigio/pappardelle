{
	"extends": "@sindresorhus/tsconfig",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ESNext", "DOM"],
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react",
		"types": ["bun"]
	},
	"include": ["source"],
	"exclude": ["source/**/*.test.ts"]
}
