{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume|clear",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${PLUGIN_ROOT}/hooks/record-agent-session.py\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${PLUGIN_ROOT}/hooks/record-agent-session.py\""
					}
				]
			}
		]
	}
}
