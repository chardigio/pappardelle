#!/bin/bash

# idow - Interactively Do on Worktree
#
# A command-line tool that sets up a development workspace.
#
# Usage: idow [--resume] [--open] [--profile <name>] [--agent-profile <name>] [--issue-key <key>] <input>
#   Input can be:
#     - Issue key:   idow STA-123 | idow 123
#     - Linear URL:  idow https://linear.app/stardust-labs/issue/STA-123
#     - Description: idow "add dark mode to settings"
#
# This command:
#   1. Parses input (issue key, URL, or description)
#   2. Creates/fetches issue as needed
#   3. Selects project profile from .pappardelle.yml
#   4. Creates a git worktree at ~/.worktrees/<project>/<issue-key>
#   5. Creates PR/MR (if new)
#   6. Opens terminal with the agent (if --open)
#   7. Opens profile-configured apps, links, and commands (if --open)

set -e

SCRIPT_NAME="idow"

# Get the directory where this script lives (resolving symlinks)
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Logging setup
LOG_DIR="$HOME/Library/Logs/stardust-workspace"
mkdir -p "$LOG_DIR"
# Each invocation owns its file so background hooks cannot mix workspaces.
# Rotate on launch and retain a week of completed invocations.
find "$LOG_DIR" -maxdepth 1 -type f -name 'idow-*.log' -mtime +7 -delete
LOG_FILE=$(mktemp "$LOG_DIR/idow-$(date '+%Y%m%d')-XXXXXX")
mv "$LOG_FILE" "$LOG_FILE.log"
LOG_FILE="$LOG_FILE.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [${ISSUE_KEY:-startup}] $*" | tee -a "$LOG_FILE"
}

error() {
    echo "Error: $*" >&2
    log "Error: $*"
    exit 1
}

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

TOTAL_STEPS=11
print_step() {
    echo -e "${BLUE}[$(printf '%2d' "$1")/$TOTAL_STEPS]${NC} $2"
    log "Step $1: $2"
}

print_success() {
    echo -e "${GREEN}  ✓${NC} $1"
    log "  Success: $1"
}

print_warning() {
    echo -e "${YELLOW}  ⚠${NC} $1"
    log "  Warning: $1"
}

# Run a CommandConfig-style command with support for background and continue_on_error.
# Usage: run_command <name> <run> <continue_on_error> <background>
run_command() {
    local CMD_NAME="$1" CMD_RUN="$2" CMD_CONTINUE="$3" CMD_BG="$4"
    if [[ -z "$CMD_RUN" ]]; then return; fi
    if [[ "$CMD_BG" == "true" ]]; then
        eval "$CMD_RUN" >>"$LOG_FILE" 2>&1 </dev/null &
        print_success "$CMD_NAME (background)"
    elif [[ "$CMD_CONTINUE" == "true" ]]; then
        if eval "$CMD_RUN" >/dev/null 2>&1; then
            print_success "$CMD_NAME"
        else
            print_warning "$CMD_NAME failed (continuing)"
        fi
    else
        eval "$CMD_RUN" >/dev/null 2>&1 || error "Command '$CMD_NAME' failed"
        print_success "$CMD_NAME"
    fi
}

# Handle help flag
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: idow [--resume] [--open] [--profile <name>] [--agent-profile <name>] [--issue-key <key>] <input>"
    echo ""
    echo "Input can be:"
    echo "  Issue key:   idow STA-123 | idow 123"
    echo "  Linear URL:  idow https://linear.app/stardust-labs/issue/STA-123"
    echo "  Description: idow \"add dark mode to settings\""
    echo ""
    echo "Options:"
    echo "  --resume          Open workspace without prompting the agent (for continuing work)"
    echo "  --open            Also open apps, links, iTerm, and run commands (skipped by default)"
    echo "  --profile <name>  Force a specific profile from .pappardelle.yml"
    echo "  --agent-profile <name>"
    echo "                    Launch this agent profile instead of the profile's, for this launch only"
    echo "  --issue-key <key> Use this issue key verbatim, skipping input-type detection"
    exit 0
fi

# Get repo root and config path
# Prefer PAPPARDELLE_PROJECT_ROOT (set by pappardelle TUI) over git resolution.
# Fallback uses cwd (not $SCRIPT_DIR) so direct invocations from a project dir work.
if [[ -n "${PAPPARDELLE_PROJECT_ROOT:-}" ]]; then
    REPO_ROOT="$PAPPARDELLE_PROJECT_ROOT"
else
    REPO_ROOT=$(git rev-parse --show-toplevel)
fi
if [[ -n "${PAPPARDELLE_MAIN_REPO_ROOT:-}" ]]; then
    MAIN_REPO_ROOT="$PAPPARDELLE_MAIN_REPO_ROOT"
else
    GIT_COMMON_DIR=$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir)
    MAIN_REPO_ROOT=$(dirname "$GIT_COMMON_DIR")
fi
# Handed to the workspace's tmux sessions so the hooks running inside them read
# it instead of walking back out to the main checkout on every tool use.
export PAPPARDELLE_MAIN_REPO_ROOT="$MAIN_REPO_ROOT"
REPO_NAME=$(basename "$MAIN_REPO_ROOT")

# Untracked project config may exist only in the main checkout, while a linked
# worktree can carry its own local overrides. Resolve each file independently.
resolve_repo_config() {
    local filename="$1"
    if [[ -f "$REPO_ROOT/$filename" ]]; then
        echo "$REPO_ROOT/$filename"
    else
        echo "$MAIN_REPO_ROOT/$filename"
    fi
}

PROJECT_CONFIG_PATH=$(resolve_repo_config .pappardelle.yml)
CONFIG_PATH="$PROJECT_CONFIG_PATH"
# Personal defaults shared across every repo. Must stay in step with
# getDefaultHomeConfigDir() in source/config.ts, which is what the TUI reads.
HOME_CONFIG_PATH="$HOME/.pappardelle/.pappardelle.yml"

# Source $REPO_ROOT/.envrc if present so per-repo env vars (e.g. a non-default
# LINCTL_API_KEY for a separate Linear workspace) reach downstream tools like
# linctl. Mirrors what direnv does, but works even when pappardelle was
# launched from a shell or long-running tmux server that didn't have direnv
# hooked. Plain `export FOO=bar` only; the direnv stdlib is not supported.
if [[ -f "$REPO_ROOT/.envrc" ]]; then
    set +e
    # shellcheck source=/dev/null
    source "$REPO_ROOT/.envrc"
    set -e
fi

# Check for config file
if [[ ! -f "$CONFIG_PATH" ]]; then
    echo -e "${YELLOW}Error: No .pappardelle.yml found at repository root.${NC}" >&2
    echo "" >&2
    echo "Pappardelle requires a configuration file to operate." >&2
    echo "Please create .pappardelle.yml at: $REPO_ROOT/.pappardelle.yml" >&2
    echo "" >&2
    echo "See _dev/scripts/pappardelle/pappardelle-config.md for the configuration schema." >&2
    exit 1
fi

# Check for yq (YAML processor)
if ! command -v yq &> /dev/null; then
    error "yq is required but not installed. Install with: brew install yq"
fi

LOCAL_CONFIG_PATH=$(resolve_repo_config .pappardelle.local.yml)

# Resolve the agent profile with its rendered launch flags, the companion
# command, and the per-profile initialization_command for the selected profile.
# profiles.<name>.<field> beats the top-level <field>; an explicit empty
# string at the profile level clears the inherited value. Called at each
# point where SELECTED_PROFILE is assigned or changed. No model or effort ⇒
# no flags at all, which is what keeps the launch identical for configs that
# never mention them (STA-1829). Values come from the merged snapshot; the
# layers are passed so each deprecation warning can name the file to edit.
DEPRECATIONS_SHOWN=false
resolve_agent_launch_config() {
    local profile="$1"
    local json
    json=$("$SCRIPT_DIR/resolve-agent-config.sh" --config "$PROJECT_CONFIG_PATH" --local-config "$LOCAL_CONFIG_PATH" --home-config "$HOME_CONFIG_PATH" --merged "$CONFIG_PATH" --profile "$profile" --agent-profile "$FORCED_AGENT_PROFILE") ||
        error "Could not resolve the agent config for profile $profile"
    # One jq pass, NUL-separated so empty and multi-line values survive.
    local profile_init_cmd_set profile_init_cmd deprecations profile_deprecations
    {
        IFS= read -r -d '' COMPANION_COMMAND
        IFS= read -r -d '' SKIP_PERMISSIONS
        IFS= read -r -d '' AGENT_MODEL
        IFS= read -r -d '' AGENT_EFFORT
        IFS= read -r -d '' AGENT_COMMAND
        IFS= read -r -d '' AGENT_ARGS
        IFS= read -r -d '' AGENT_RESUME_ARGS
        IFS= read -r -d '' AGENT_IS_CLAUDE
        IFS= read -r -d '' AGENT_PROFILE
        IFS= read -r -d '' AGENT_LAUNCH_FLAGS
        IFS= read -r -d '' INIT_CMD
        IFS= read -r -d '' profile_init_cmd_set
        IFS= read -r -d '' profile_init_cmd
        IFS= read -r -d '' deprecations
        IFS= read -r -d '' profile_deprecations
    } < <(jq -j '[.companion_command, .skip_permissions, .model, .effort, .agent_command, .agent_args,
        .agent_resume_args, .agent_is_claude, .agent_profile, .agent_launch_flags, .init_cmd,
        .profile_init_cmd_set, .profile_init_cmd, .deprecation_warnings,
        .profile_deprecation_warnings][] | tostring | sub("\n+$"; "") + "\u0000"' <<< "$json")
    [[ -n "$AGENT_MODEL" ]] && log "Model: $AGENT_MODEL"
    [[ -n "$AGENT_EFFORT" ]] && log "Effort: $AGENT_EFFORT"
    [[ "$AGENT_COMMAND" != "claude" ]] && log "Agent: $AGENT_COMMAND"

    local warning
    # The top-level warnings don't depend on the profile, so they print once
    # even when a tracker project re-selects it.
    if [[ "$DEPRECATIONS_SHOWN" == false ]]; then
        while IFS= read -r warning; do
            if [[ -n "$warning" ]]; then print_warning "$warning"; fi
        done <<< "$deprecations"
        DEPRECATIONS_SHOWN=true
    fi
    while IFS= read -r warning; do
        if [[ -n "$warning" ]]; then print_warning "$warning"; fi
    done <<< "$profile_deprecations"
    # The profile's initialization_command replaces the top-level one. Key
    # presence decides, not non-emptiness: an explicit '' clears the top-level
    # command so the agent gets just the issue key. Set from scratch each call,
    # since a tracker project can re-select the profile.
    if [[ "$profile_init_cmd_set" == true ]]; then
        INIT_CMD="$profile_init_cmd"
        log "Using per-profile initialization_command: $INIT_CMD"
    fi
    return 0
}

# Source provider-agnostic helpers
# shellcheck source=provider-helpers.sh
source "$SCRIPT_DIR/provider-helpers.sh"

# From here on, read the merged config so home and local layers apply to
# every field (profiles, team_prefix, providers, apps, links, hooks, ...),
# not only the Claude settings that resolve-agent-config.sh layers itself.
MERGED_CONFIG_PATH=$(mktemp -t pappardelle-config.XXXXXX)
CONFIG_RECORDS_PATH=$(mktemp -t pappardelle-records.XXXXXX)
trap 'rm -f "$MERGED_CONFIG_PATH" "$CONFIG_RECORDS_PATH"' EXIT
merge_config_layers "$HOME_CONFIG_PATH" "$PROJECT_CONFIG_PATH" "$LOCAL_CONFIG_PATH" > "$MERGED_CONFIG_PATH"
CONFIG_PATH="$MERGED_CONFIG_PATH"
TERMINAL_OPEN_FAILED=false

# Write a command/app/link list as NUL-delimited fields, so empty strings,
# tabs and internal newlines survive. Trailing newlines are stripped, as YAML
# block scalars add one that would otherwise end up in the command. Only the
# selected fields go through JSON, because yq cannot write some YAML-only
# values (.inf, huge integers) as JSON.
config_records() (
    # Validate the whole list before running any command. A process substitution
    # would hide parser failures and could silently skip required setup steps.
    set -o pipefail
    yq -o=json "explode(.) | $1" "$CONFIG_PATH" | jq -j '.[] | .[] | (tostring | sub("\n+$"; "")) + "\u0000"' > "$CONFIG_RECORDS_PATH"
)

# Run every {name, run, continue_on_error, background} entry of the list at
# yq path $1, naming unnamed entries with the printf format $3 and their index.
# Pass --no-header as $4 when a step header already announces the list.
# Returns 1 when the list is empty or missing.
run_configured_commands() {
    local list_path="$1" label="$2" name_format="$3" header="${4:-}" i=0 name run_tmpl run continue_on_error background
    config_records "[($list_path // [])[] | [.name // \"\", .run // \"\", .continue_on_error // false, .background // false]]" ||
        error "Could not read $label commands from config"
    [[ -s "$CONFIG_RECORDS_PATH" ]] || return 1
    [[ "$header" == --no-header ]] || log "Running $label commands..."
    while IFS= read -r -u 3 -d '' name &&
          IFS= read -r -u 3 -d '' run_tmpl &&
          IFS= read -r -u 3 -d '' continue_on_error &&
          IFS= read -r -u 3 -d '' background; do
        # shellcheck disable=SC2059 # the format is one of this file's literals
        [[ -n "$name" ]] || printf -v name "$name_format" "$i"
        run=$(expand_var "$run_tmpl")
        log "  $label: $name -> $run"
        run_command "$name" "$run" "$continue_on_error" "$background" 3<&-
        i=$((i + 1))
    done 3< "$CONFIG_RECORDS_PATH"
}

# The PR/MR lookup is a network call, so only make it when something in the
# profile or hooks references PR_URL/MR_URL. If the config can't be inspected,
# look it up anyway rather than drop a configured PR link.
profile_uses_pr_url() {
    local consumers
    if ! consumers=$(yq -r "explode(.) | [.profiles.$SELECTED_PROFILE.vars, .profiles.$SELECTED_PROFILE.commands, .profiles.$SELECTED_PROFILE.apps, .profiles.$SELECTED_PROFILE.links, .hooks.post_workspace_create]" "$CONFIG_PATH"); then
        return 0
    fi
    [[ "$consumers" == *PR_URL* || "$consumers" == *MR_URL* ]]
}

# Detect configured providers
TRACKER_PROVIDER=$(get_issue_tracker_provider "$CONFIG_PATH")
VCS_PROVIDER=$(get_vcs_host_provider "$CONFIG_PATH")

# Helper function to get profile value
get_profile_value() {
    local profile="$1"
    local path="$2"
    yq -r ".profiles.$profile.$path // \"\"" "$CONFIG_PATH"
}

# Helper function to list all profiles
list_profiles() {
    yq -r '.profiles | keys | .[]' "$CONFIG_PATH"
}

# Helper function to get profile display name
get_profile_display_name() {
    local profile="$1"
    yq -r ".profiles.$profile.display_name // \"$profile\"" "$CONFIG_PATH"
}

# Function to match profiles based on keywords
match_profiles() {
    local input="$1"
    local input_lower
    input_lower=$(echo "$input" | tr '[:upper:]' '[:lower:]')

    local matched_profiles=()

    for profile in $(list_profiles); do
        local matched=false

        # Use while-read to preserve multi-word keywords (e.g. "hit the weekly")
        while IFS= read -r keyword; do
            [[ -z "$keyword" ]] && continue
            local keyword_lower
            keyword_lower=$(echo "$keyword" | tr '[:upper:]' '[:lower:]')

            # Use word-boundary matching to prevent "king" matching "looking"
            if echo "$input_lower" | grep -qw "$keyword_lower"; then
                matched=true
                break
            fi
        done < <(yq -r ".profiles.$profile.keywords[]" "$CONFIG_PATH" 2>/dev/null)

        if [[ "$matched" == true ]]; then
            # Check if profile is already in matched list
            local already_matched=false
            for mp in "${matched_profiles[@]}"; do
                if [[ "$mp" == "$profile" ]]; then
                    already_matched=true
                    break
                fi
            done

            if [[ "$already_matched" == false ]]; then
                matched_profiles+=("$profile")
            fi
        fi
    done

    echo "${matched_profiles[@]}"
}

# Function to prompt user to select a profile
select_profile_interactive() {
    local preselected="$1"

    # Output prompts to stderr so stdout only contains the result
    echo "" >&2
    echo -e "${CYAN}Select a project profile:${NC}" >&2
    echo "" >&2

    local profiles=()
    local i=1

    for profile in $(list_profiles); do
        local display_name
        display_name=$(get_profile_display_name "$profile")

        if [[ "$profile" == "$preselected" ]]; then
            echo -e "  ${GREEN}[$i] $display_name (auto-detected)${NC}" >&2
        else
            echo "  [$i] $display_name" >&2
        fi

        profiles+=("$profile")
        ((i++))
    done

    echo "" >&2

    # Default to preselected if available
    local default_num=""
    if [[ -n "$preselected" ]]; then
        for j in "${!profiles[@]}"; do
            if [[ "${profiles[$j]}" == "$preselected" ]]; then
                default_num=$((j + 1))
                break
            fi
        done
    fi

    local prompt="Enter number"
    if [[ -n "$default_num" ]]; then
        prompt="$prompt [$default_num]"
    fi
    prompt="$prompt: "

    # If stdin is not a tty, use the default/preselected without prompting
    if [[ ! -t 0 ]]; then
        if [[ -n "$default_num" ]]; then
            echo "${profiles[$((default_num - 1))]}"
            return
        else
            # No default, use first profile
            echo "${profiles[0]}"
            return
        fi
    fi

    read -r -p "$prompt" selection

    # Use default if empty
    if [[ -z "$selection" && -n "$default_num" ]]; then
        selection="$default_num"
    fi

    # Validate selection
    if [[ ! "$selection" =~ ^[0-9]+$ ]] || [[ "$selection" -lt 1 ]] || [[ "$selection" -gt "${#profiles[@]}" ]]; then
        error "Invalid selection: $selection"
    fi

    echo "${profiles[$((selection - 1))]}"
}

# Check for --resume flag
RESUME_MODE=false
if [[ "$1" == "--resume" ]]; then
    RESUME_MODE=true
    shift
fi

# Check for --open flag (opt-in to opening apps/links/iTerm/commands)
# By default, idow only does setup (worktree, PR, etc.) without opening anything.
# Pass --open to also open iTerm, apps, links, simulator, and commands.
OPEN_WORKSPACE=false
if [[ "$1" == "--open" ]]; then
    OPEN_WORKSPACE=true
    shift
fi

# Check for --profile flag
FORCED_PROFILE=""
if [[ "$1" == "--profile" ]]; then
    FORCED_PROFILE="$2"
    shift 2

    # Validate the profile exists
    if ! list_profiles | grep -q "^${FORCED_PROFILE}$"; then
        echo -e "${YELLOW}Error: Profile \"$FORCED_PROFILE\" not found.${NC}" >&2
        echo "" >&2
        echo "Available profiles:" >&2
        for profile in $(list_profiles); do
            display_name=$(get_profile_display_name "$profile")
            echo "  - $profile: $display_name" >&2
        done
        exit 1
    fi
fi

# Not persisted: a later launch of the space goes back to the profile's agent.
FORCED_AGENT_PROFILE=""
if [[ "$1" == "--agent-profile" ]]; then
    FORCED_AGENT_PROFILE="$2"
    if [[ -z "$FORCED_AGENT_PROFILE" ]]; then
        echo "Error: --agent-profile needs an agent profile name" >&2
        exit 1
    fi
    shift 2

    # Checked here rather than left to resolve-agent-config.sh, which only runs
    # after the issue fetch and worktree setup.
    if [[ "$FORCED_AGENT_PROFILE" != "claude" \
          && "$(AGENT_PROFILE="$FORCED_AGENT_PROFILE" yq -r '.agent_profiles // {} | has(strenv(AGENT_PROFILE))' "$CONFIG_PATH")" != "true" ]]; then
        echo -e "${YELLOW}Error: agent profile \"$FORCED_AGENT_PROFILE\" not found in agent_profiles${NC}" >&2
        exit 1
    fi
fi

# A beads ID is a content hash, so `myproj-a1b2` and the description `fix-crash`
# are the same shape. Callers that already hold a resolved key say so rather than
# leaving the detection below to guess.
INPUT_IS_ISSUE_KEY=false
if [[ "$1" == "--issue-key" ]]; then
    INPUT_IS_ISSUE_KEY=true
    shift
fi

# Collect input from all arguments
INPUT="$*"

if [[ -z "$INPUT" ]]; then
    echo "Usage: idow [--profile <name>] [--agent-profile <name>] <input>"
    echo ""
    echo "Input can be:"
    echo "  Issue key:   idow STA-123 | idow 123"
    echo "  Linear URL:  idow https://linear.app/stardust-labs/issue/STA-123"
    echo "  Description: idow \"add dark mode to settings\""
    exit 1
fi

log "=== $SCRIPT_NAME started ==="
log "Input: $INPUT"

echo ""
echo "Starting workspace setup..."
echo ""

# Read team prefix from config (used for bare-number issue input and issue creation)
TEAM_PREFIX=$(yq -r '.team_prefix // "STA"' "$CONFIG_PATH" | tr '[:lower:]' '[:upper:]')

# Determine input type and extract issue key if applicable
ISSUE_KEY=""
DESCRIPTION=""
IS_NEW_ISSUE=false

if [[ "$INPUT_IS_ISSUE_KEY" == "true" ]]; then
    ISSUE_KEY="$INPUT"
    log "Caller-supplied issue key: $ISSUE_KEY"
elif [[ "$INPUT" =~ ^https://linear\.app/.*/issue/([A-Z][A-Z0-9]*-[0-9]+) ]]; then
    # Linear URL
    ISSUE_KEY="${BASH_REMATCH[1]}"
    log "Detected Linear URL, issue key: $ISSUE_KEY"
elif [[ "$TRACKER_PROVIDER" == "beads" ]] && is_beads_issue_key "$INPUT" "$CONFIG_PATH"; then
    ISSUE_KEY=$(echo "$INPUT" | tr '[:upper:]' '[:lower:]')
    log "Detected beads issue ID: $ISSUE_KEY"
elif [[ "$INPUT" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]]; then
    # Full issue key (e.g., STA-123)
    ISSUE_KEY="$INPUT"
    log "Detected full issue key: $ISSUE_KEY"
elif [[ "$INPUT" =~ ^[0-9]+$ ]]; then
    # Just a number (e.g., 123) - use configured team prefix
    if [[ "$TRACKER_PROVIDER" == "beads" ]]; then
        ISSUE_KEY="$(echo "$TEAM_PREFIX" | tr '[:upper:]' '[:lower:]')-$INPUT"
    else
        ISSUE_KEY="${TEAM_PREFIX}-$INPUT"
    fi
    log "Detected number, assuming issue key: $ISSUE_KEY"
else
    # It's a description - we'll create a new issue
    DESCRIPTION="$INPUT"
    IS_NEW_ISSUE=true
    log "Detected description, will create new issue"
fi

# Capture the Ghostty window now, before worktree creation and profile commands,
# which can run for minutes. By the time step 9 opens the tab the TUI may no
# longer be frontmost, and the tab has to land in the window the user is in.
#
# Gated on --open as well: the Apple Event would otherwise launch Ghostty, and
# can raise the Automation permission prompt, on runs that never open anything.
TERMINAL_APP=""
if [[ "$OPEN_WORKSPACE" == true ]]; then
    TERMINAL_APP=$("$SCRIPT_DIR/resolve-terminal-app.sh" --config "$CONFIG_PATH")
fi
GHOSTTY_WINDOW_ID=""
if [[ "$OPEN_WORKSPACE" == true && "$TERMINAL_APP" == "Ghostty" ]]; then
    GHOSTTY_WINDOW_ID=$(osascript -e 'tell application "Ghostty" to get id of front window' 2>/dev/null || true)
fi

# Step 1: Select profile from .pappardelle.yml
print_step 1 "Selecting project profile..."

SELECTED_PROFILE=""

if [[ -n "$FORCED_PROFILE" ]]; then
    # Profile was specified via --profile flag
    SELECTED_PROFILE="$FORCED_PROFILE"
    print_success "Using profile: $(get_profile_display_name "$SELECTED_PROFILE") (forced)"
elif [[ "$IS_NEW_ISSUE" == true ]]; then
    # Try to match profile based on description keywords
    MATCHED_PROFILES=$(match_profiles "$DESCRIPTION")
    MATCHED_COUNT=$(echo "$MATCHED_PROFILES" | wc -w | tr -d ' ')

    if [[ "$MATCHED_COUNT" -eq 1 ]]; then
        # Single match - auto-select but allow override
        SELECTED_PROFILE=$(select_profile_interactive "$MATCHED_PROFILES")
    elif [[ "$MATCHED_COUNT" -gt 1 ]]; then
        # Multiple matches - prompt user, suggest first match
        FIRST_MATCH=$(echo "$MATCHED_PROFILES" | awk '{print $1}')
        SELECTED_PROFILE=$(select_profile_interactive "$FIRST_MATCH")
    else
        # No matches - use default profile, prompt user
        DEFAULT_PROFILE=$(yq -r '.default_profile' "$CONFIG_PATH")
        SELECTED_PROFILE=$(select_profile_interactive "$DEFAULT_PROFILE")
    fi
    print_success "Selected profile: $(get_profile_display_name "$SELECTED_PROFILE")"
else
    # An existing space keeps the profile it was created or last picked with,
    # so reopening it can't relaunch a different agent. The TUI's
    # attachToSpace() reads the same field.
    PERSISTED_PROFILE=$(jq -r '.profile // ""' "$HOME/.pappardelle/repos/$REPO_NAME/space-state/$ISSUE_KEY.json" 2>/dev/null || true)
    if [[ -n "$PERSISTED_PROFILE" && "$(PROFILE="$PERSISTED_PROFILE" yq -r '.profiles | has(strenv(PROFILE))' "$CONFIG_PATH")" == "true" ]]; then
        SELECTED_PROFILE="$PERSISTED_PROFILE"
        print_success "Using the space's profile: $(get_profile_display_name "$SELECTED_PROFILE")"
    else
        PERSISTED_PROFILE=""
        DEFAULT_PROFILE=$(yq -r '.default_profile' "$CONFIG_PATH")
        SELECTED_PROFILE="$DEFAULT_PROFILE"
        print_success "Using default profile: $(get_profile_display_name "$SELECTED_PROFILE")"
    fi
fi

# Extract generic profile vars (bash 3.2 compatible — no associative arrays)
PROFILE_VAR_KEYS=""
while IFS='=' read -r key value; do
    [[ -n "$key" ]] && PROFILE_VAR_KEYS="$PROFILE_VAR_KEYS $key" && declare "$key=$value"
done < <(yq -r '.profiles.'"$SELECTED_PROFILE"'.vars // {} | to_entries[] | .key + "=" + .value' "$CONFIG_PATH")

# Read per-profile team prefix (falls back to global TEAM_PREFIX)
PROFILE_TEAM_PREFIX=$(yq -r ".profiles.$SELECTED_PROFILE.team_prefix // \"\"" "$CONFIG_PATH" | tr '[:lower:]' '[:upper:]')
if [[ -n "$PROFILE_TEAM_PREFIX" ]]; then
    EFFECTIVE_TEAM_PREFIX="$PROFILE_TEAM_PREFIX"
else
    EFFECTIVE_TEAM_PREFIX="$TEAM_PREFIX"
fi

# Read per-profile Jira issue type override (provider-helpers falls back to
# .issue_tracker.default_issue_type and finally "Task" when this is empty).
PROFILE_JIRA_ISSUE_TYPE=$(yq -r ".profiles.$SELECTED_PROFILE.jira.issue_type // \"\"" "$CONFIG_PATH")

# Use profile name as project key
PROJECT_KEY="$SELECTED_PROFILE"

# Get VCS label from profile (provider-agnostic, falls back to github.label)
VCS_LABEL=$(yq -r ".profiles.$SELECTED_PROFILE.vcs.label // .profiles.$SELECTED_PROFILE.github.label // \"\"" "$CONFIG_PATH")

resolve_agent_launch_config "$SELECTED_PROFILE"

log "Profile: $SELECTED_PROFILE, vars:$PROFILE_VAR_KEYS"

# Step 2: Get or create issue
print_step 2 "Setting up issue ($TRACKER_PROVIDER)..."

if [[ "$IS_NEW_ISSUE" == true ]]; then
    # Derive title
    print_step 3 "Generating issue title..."
    TITLE=$("$SCRIPT_DIR/derive-title.sh" "$DESCRIPTION") || error "Failed to derive title"
    print_success "Title: $TITLE"

    # Create issue via provider
    print_step 4 "Creating issue..."
    CREATE_ISSUE_ARGS=(--title "$TITLE" --prompt "$DESCRIPTION" --config "$CONFIG_PATH" --team "$EFFECTIVE_TEAM_PREFIX" --profile "$SELECTED_PROFILE")
    if [[ -n "$PROFILE_JIRA_ISSUE_TYPE" ]]; then
        CREATE_ISSUE_ARGS+=(--issue-type "$PROFILE_JIRA_ISSUE_TYPE")
    fi
    ISSUE_JSON=$(create_issue "${CREATE_ISSUE_ARGS[@]}") || error "Failed to create issue"
    ISSUE_KEY=$(echo "$ISSUE_JSON" | jq -r '.issue_key')
    ISSUE_URL=$(echo "$ISSUE_JSON" | jq -r '.issue_url')
    # The matched profile's tracker_projects[0] is auto-applied as the Linear
    # project (STA-959). When the profile has no tracker_projects, the issue
    # is created unassigned.
    print_success "Created issue: $ISSUE_KEY"

    # Write issue metadata for hook tracking (plan → description vs comment)
    # Namespaced per-repo under ~/.pappardelle/repos/{repoName}/issue-meta/
    ISSUE_META_DIR="$HOME/.pappardelle/repos/$REPO_NAME/issue-meta"
    mkdir -p "$ISSUE_META_DIR"
    echo "{\"created_by_pappardelle\": true, \"created_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" > "$ISSUE_META_DIR/$ISSUE_KEY.json"
else
    # Fetch existing issue via provider
    print_step 3 "Fetching issue ($TRACKER_PROVIDER)..."
    ISSUE_JSON=$(fetch_issue_json "$ISSUE_KEY" "$CONFIG_PATH") || error "Failed to fetch issue $ISSUE_KEY"
    TITLE=$(extract_issue_title "$ISSUE_JSON" "$CONFIG_PATH")
    DESCRIPTION=$(extract_issue_description "$ISSUE_JSON" "$CONFIG_PATH")
    ISSUE_URL=$(extract_issue_url "$ISSUE_JSON" "$CONFIG_PATH" "$ISSUE_KEY")

    if [[ -z "$TITLE" ]]; then
        error "Issue $ISSUE_KEY not found"
    fi
    print_success "Issue: $TITLE"

    # Get project info from issue if available. Candidates are provider-aware:
    # Linear yields the project name; Jira yields the name AND the project key
    # so tracker_projects entries can be either (STA-1649).
    print_step 4 "Checking project..."
    PROJECT_CANDIDATES=$(extract_issue_project_candidates "$ISSUE_JSON" "$CONFIG_PATH")
    TRACKER_PROJECT=$(echo "$PROJECT_CANDIDATES" | head -1)
    if [[ -n "$TRACKER_PROJECT" ]]; then
        print_success "Project: $TRACKER_PROJECT"

        # Try to match a profile by tracker project (if not already forced)
        if [[ -z "$FORCED_PROFILE" && -z "${PERSISTED_PROFILE:-}" ]]; then
            PROJECT_MATCHED_PROFILE=$(match_profile_by_tracker_project "$PROJECT_CANDIDATES" "$CONFIG_PATH")
            if [[ -n "$PROJECT_MATCHED_PROFILE" ]]; then
                PREVIOUS_PROFILE="$SELECTED_PROFILE"
                SELECTED_PROFILE="$PROJECT_MATCHED_PROFILE"
                print_success "Profile matched by project: $(get_profile_display_name "$SELECTED_PROFILE")"

                # Re-extract profile-derived values for the matched profile
                PROFILE_VAR_KEYS=""
                while IFS='=' read -r key value; do
                    [[ -n "$key" ]] && PROFILE_VAR_KEYS="$PROFILE_VAR_KEYS $key" && declare "$key=$value"
                done < <(yq -r '.profiles.'"$SELECTED_PROFILE"'.vars // {} | to_entries[] | .key + "=" + .value' "$CONFIG_PATH")

                PROFILE_TEAM_PREFIX=$(yq -r ".profiles.$SELECTED_PROFILE.team_prefix // \"\"" "$CONFIG_PATH" | tr '[:lower:]' '[:upper:]')
                if [[ -n "$PROFILE_TEAM_PREFIX" ]]; then
                    EFFECTIVE_TEAM_PREFIX="$PROFILE_TEAM_PREFIX"
                else
                    EFFECTIVE_TEAM_PREFIX="$TEAM_PREFIX"
                fi

                PROJECT_KEY="$SELECTED_PROFILE"
                VCS_LABEL=$(yq -r ".profiles.$SELECTED_PROFILE.vcs.label // .profiles.$SELECTED_PROFILE.github.label // \"\"" "$CONFIG_PATH")

                log "Profile updated: $SELECTED_PROFILE, vars:$PROFILE_VAR_KEYS"
                [[ "$SELECTED_PROFILE" == "$PREVIOUS_PROFILE" ]] || resolve_agent_launch_config "$SELECTED_PROFILE"
            fi
        fi
    else
        print_success "No project assigned (will use defaults)"
    fi
fi

# Extract issue number for template variable expansion (e.g., STA-595 → 595,
# pappardelle-wx0 → wx0).
#
# Everything after the last hyphen, not the first digit run: Jira project keys
# may carry digits of their own, and scanning left-to-right turned A1B-234 into
# the plausible-looking but wrong "1".
ISSUE_NUMBER="${ISSUE_KEY##*-}"

WORKSPACE_LOG="$LOG_DIR/idow-${ISSUE_KEY//[^a-zA-Z0-9._-]/_}-${LOG_FILE##*/idow-}"
mv "$LOG_FILE" "$WORKSPACE_LOG"
LOG_FILE="$WORKSPACE_LOG"

# Template expansion helpers for profile-driven steps
# Defined here (before Step 5) because worktree config may use template variables.
expand_var() {
    local template="$1"
    local result="$template"
    result="${result//\$\{WORKTREE_PATH\}/$WORKTREE_PATH}"
    result="${result//\$\{ISSUE_KEY\}/$ISSUE_KEY}"
    result="${result//\$\{ISSUE_NUMBER\}/$ISSUE_NUMBER}"
    result="${result//\$\{ISSUE_URL\}/$ISSUE_URL}"
    result="${result//\$\{REPO_ROOT\}/$REPO_ROOT}"
    result="${result//\$\{MAIN_REPO_ROOT\}/$MAIN_REPO_ROOT}"
    result="${result//\$\{REPO_NAME\}/$REPO_NAME}"
    result="${result//\$\{PR_URL\}/$PR_URL}"
    result="${result//\$\{MR_URL\}/$PR_URL}"
    result="${result//\$\{SCRIPT_DIR\}/$SCRIPT_DIR}"
    result="${result//\$\{TITLE\}/$TITLE}"
    result="${result//\$\{DESCRIPTION\}/$DESCRIPTION}"
    result="${result//\$\{VCS_LABEL\}/$VCS_LABEL}"
    result="${result//\$\{GITHUB_LABEL\}/$VCS_LABEL}"
    result="${result//\$\{TRACKER_PROVIDER\}/$TRACKER_PROVIDER}"
    result="${result//\$\{VCS_PROVIDER\}/$VCS_PROVIDER}"
    # Expand generic profile vars
    for key in $PROFILE_VAR_KEYS; do
        result="${result//\$\{$key\}/${!key}}"
    done
    echo "$result"
}

# Check if a template variable is set (for if_set gating)
var_is_set() {
    local var_name="$1"
    [[ -z "$var_name" ]] && return 0  # no condition = always include
    case "$var_name" in
        WORKTREE_PATH) [[ -n "$WORKTREE_PATH" ]] ;;
        PR_URL|MR_URL) [[ -n "$PR_URL" ]] ;;
        ISSUE_URL) [[ -n "$ISSUE_URL" ]] ;;
        TITLE) [[ -n "$TITLE" ]] ;;
        DESCRIPTION) [[ -n "$DESCRIPTION" ]] ;;
        *) # Check profile vars / env var via indirect expansion
           [[ -n "${!var_name:-}" ]] ;;
    esac
}

# Step 5: Create or find worktree
print_step 5 "Setting up git worktree..."
WORKTREE_PATH="$HOME/.worktrees/$REPO_NAME/$ISSUE_KEY"
FRESH_WORKSPACE=false

WORKTREE_CREATED=false
if [[ -d "$WORKTREE_PATH" ]]; then
    print_success "Worktree exists: $WORKTREE_PATH"
else
    WORKTREE_CREATED=true
    CREATE_WORKTREE_ARGS=(--issue-key "$ISSUE_KEY" --project-key "$PROJECT_KEY")
    WORKTREE_JSON=$("$SCRIPT_DIR/create-worktree.sh" "${CREATE_WORKTREE_ARGS[@]}") || error "Failed to create worktree"
    WORKTREE_PATH=$(echo "$WORKTREE_JSON" | jq -r '.worktree_path')
    print_success "Created worktree: $WORKTREE_PATH"
    # Existing issue keys may have resumable history even after their worktree
    # was deleted; only a newly created issue is guaranteed to have none.
    FRESH_WORKSPACE="$IS_NEW_ISSUE"

    # Copy .pappardelle.local.yml to the new worktree (gitignored personal overrides)
    LOCAL_CONFIG="$LOCAL_CONFIG_PATH"
    if [[ -f "$LOCAL_CONFIG" ]]; then
        cp -n "$LOCAL_CONFIG" "$WORKTREE_PATH/.pappardelle.local.yml" 2>/dev/null || true
        print_success "Copied .pappardelle.local.yml"
    fi

    # Copy .claude/settings.local.json to the new worktree (gitignored personal overrides)
    CLAUDE_LOCAL_SETTINGS="$REPO_ROOT/.claude/settings.local.json"
    if [[ -f "$CLAUDE_LOCAL_SETTINGS" ]]; then
        mkdir -p "$WORKTREE_PATH/.claude"
        cp -n "$CLAUDE_LOCAL_SETTINGS" "$WORKTREE_PATH/.claude/settings.local.json" 2>/dev/null || true
        print_success "Copied .claude/settings.local.json"
    fi

    # post_worktree_init is the legacy name, used only when post_workspace_init is empty
    run_configured_commands '(.post_workspace_init | select(length > 0)) // .post_worktree_init' post_workspace_init 'post_workspace_init[%d]' || true
    run_configured_commands "(.profiles.$SELECTED_PROFILE.post_workspace_init | select(length > 0)) // .profiles.$SELECTED_PROFILE.post_worktree_init" "profile post_workspace_init" 'profile_post_init[%d]' || true
fi

SPACE_STATE_DIR="$HOME/.pappardelle/repos/$REPO_NAME/space-state"
SPACE_STATE_FILE="$SPACE_STATE_DIR/$ISSUE_KEY.json"
AGENT_SESSIONS_FILE="$SPACE_STATE_DIR/$ISSUE_KEY.agent-sessions.json"
# A new issue's key can't own a conversation, so any recorded session belonged
# to an earlier issue with the same key.
if [[ "$FRESH_WORKSPACE" == true ]]; then
    rm -f "$AGENT_SESSIONS_FILE"
fi

if [[ "$WORKTREE_CREATED" == true || -n "$FORCED_PROFILE" ]]; then
    # Persist the profile to space-state: the TUI renders the ticket-rail emoji
    # from it on first paint (STA-930), and both the TUI and later idow runs launch
    # the space's agent from it. Written when the workspace is created or a profile
    # is picked explicitly (--profile). An unforced run on an existing space either
    # read this value above or fell back to default_profile, which must not
    # overwrite a real pick.
    mkdir -p "$SPACE_STATE_DIR"
    NOW_ISO=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [[ -f "$SPACE_STATE_FILE" ]]; then
        # Merge so we don't clobber rail-status / recap fields written by the
        # TUI poller (writeSpaceState in space-state.ts does the same merge).
        # `&&` is part of a compound, so `set -e` doesn't trip on jq failure —
        # gate the success log on the actual exit status and clean up the
        # tempfile so a corrupted JSON read can't leak into /tmp.
        TMP_FILE=$(mktemp)
        if jq --arg p "$SELECTED_PROFILE" --arg t "$NOW_ISO" \
                '. + {profile: $p, updatedAt: $t}' \
                "$SPACE_STATE_FILE" > "$TMP_FILE" && mv "$TMP_FILE" "$SPACE_STATE_FILE"; then
            log "Persisted profile '$SELECTED_PROFILE' to $SPACE_STATE_FILE"
        else
            log "Warning: failed to persist profile '$SELECTED_PROFILE' to $SPACE_STATE_FILE"
            rm -f "$TMP_FILE"
        fi
    else
        # `jq -n` generates from scratch (no file input) so failure is
        # essentially impossible; the redirect already creates the file.
        jq -n --arg p "$SELECTED_PROFILE" --arg t "$NOW_ISO" \
            '{profile: $p, updatedAt: $t}' > "$SPACE_STATE_FILE"
        log "Persisted profile '$SELECTED_PROFILE' to $SPACE_STATE_FILE"
    fi
fi

# PR URLs are only needed when opening configured apps and links.
PR_URL=""
cd "$WORKTREE_PATH"

# Step 6: Ensure agent and companion tmux sessions exist (always, regardless of --open)
print_step 6 "Starting agent tmux session..."
# A new issue has no conversation of its own to resume. An existing issue keeps
# its conversation even when its worktree was deleted and recreated:
# {session_id} is the id the agent's hook recorded for this space under the
# same agent profile (hooks/agent_session.py), and with none claude falls back
# to its directory-scoped --continue while other agents launch fresh with the
# prompt. Resume args without {session_id} aren't tied to the space (codex's
# `resume --last` picks the most recent session from any directory), so a
# recreated worktree drops them. Mirrors bindResumeArgs() in source/config.ts.
if [[ "$FRESH_WORKSPACE" == true ]]; then
    AGENT_RESUME_ARGS=""
elif [[ "$AGENT_RESUME_ARGS" == *"{session_id}"* ]]; then
    RECORDED_SESSION_ID=$(jq -r --arg profile "$AGENT_PROFILE" \
        '.[$profile]? // ""' \
        "$AGENT_SESSIONS_FILE" 2>/dev/null || true)
    if [[ "$RECORDED_SESSION_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        AGENT_RESUME_ARGS="${AGENT_RESUME_ARGS//\{session_id\}/$RECORDED_SESSION_ID}"
    elif [[ "$AGENT_IS_CLAUDE" == true ]]; then
        # Only the resume-by-id flag becomes --continue; other flags stay.
        AGENT_RESUME_ARGS="${AGENT_RESUME_ARGS//--resume \{session_id\}/--continue}"
        AGENT_RESUME_ARGS="${AGENT_RESUME_ARGS//--resume=\{session_id\}/--continue}"
        AGENT_RESUME_ARGS="${AGENT_RESUME_ARGS//-r \{session_id\}/--continue}"
        [[ "$AGENT_RESUME_ARGS" != *"{session_id}"* ]] || AGENT_RESUME_ARGS="--continue"
    else
        AGENT_RESUME_ARGS=""
    fi
elif [[ "$WORKTREE_CREATED" == true ]]; then
    # Not tied to this space, so a recreated worktree can't trust them.
    AGENT_RESUME_ARGS=""
fi
# One array for the resolved agent profile, appended to both start-agent-session.sh
# and the terminal launchers below so the two launch paths can't drift.
AGENT_FLAG_ARGS=(--agent-command "$AGENT_COMMAND" --agent-args "$AGENT_ARGS" --agent-resume-args "$AGENT_RESUME_ARGS" --agent-is-claude "$AGENT_IS_CLAUDE" --agent-launch-flags "$AGENT_LAUNCH_FLAGS" --agent-profile "$AGENT_PROFILE")
AGENT_SESSION_ARGS=(--issue-key "$ISSUE_KEY" --repo-name "$REPO_NAME" --worktree "$WORKTREE_PATH" --companion-command "$COMPANION_COMMAND")
if [[ -n "$INIT_CMD" && "$RESUME_MODE" != true ]]; then
    AGENT_SESSION_ARGS+=(--init-cmd "$INIT_CMD")
fi
if [[ "$SKIP_PERMISSIONS" == "true" ]]; then
    AGENT_SESSION_ARGS+=(--skip-permissions)
fi
# Matches the '.' → '_' encoding in start-agent-session.sh and
# getSessionNames(); see the comment there.
SESSION_KEY="${ISSUE_KEY//_/__}"
SESSION_KEY="${SESSION_KEY//./_}"
AGENT_SESSION_ARGS+=("${AGENT_FLAG_ARGS[@]}")
AGENT_SESSION_NAME="agent-${REPO_NAME}-${SESSION_KEY}"
LEGACY_AGENT_SESSION_NAME="claude-${REPO_NAME}-${SESSION_KEY}"
# Per-issue agent/companion sessions live on a dedicated tmux socket so the
# Pappardelle viewer pane can attach without TMUX=. See STA-860.
PAPPARDELLE_TMUX_SOCKET="${PAPPARDELLE_TMUX_SOCKET:-pappardelle_inner}"
export PAPPARDELLE_TMUX_SOCKET
# start-agent-session.sh leaves a running agent alone, and renames a
# pre-upgrade claude-* one instead of starting the picked agent profile.
if [[ -n "$FORCED_AGENT_PROFILE" ]] && {
    tmux -L "$PAPPARDELLE_TMUX_SOCKET" has-session -t "=$AGENT_SESSION_NAME:" 2>/dev/null ||
        tmux -L "$PAPPARDELLE_TMUX_SOCKET" has-session -t "=$LEGACY_AGENT_SESSION_NAME:" 2>/dev/null
}; then
    print_warning "Agent session already running, so the agent profile override was not applied"
    # Read by idowSkippedAgentOverride() in source/session-routing.ts.
    echo "PAPPARDELLE_AGENT_PROFILE_OVERRIDE=skipped"
fi
"$SCRIPT_DIR/start-agent-session.sh" "${AGENT_SESSION_ARGS[@]}" || print_warning "Failed to start agent tmux session"
if tmux -L "$PAPPARDELLE_TMUX_SOCKET" has-session -t "=$AGENT_SESSION_NAME:" 2>/dev/null; then
    print_success "Agent session: $AGENT_SESSION_NAME"
else
    print_warning "Agent session not created (is tmux running?)"
fi

# Steps 7-11: Find the PR, run commands, open apps, links, terminal
# Skipped by default. Pass --open to run these steps.
# In pappardelle, user presses 'o' on a space to open.
if [[ "$OPEN_WORKSPACE" != true ]]; then
    print_step 7 "Skipping open steps (pass --open to open apps)"
    print_success "Setup complete"
else

# Resolve a PR only when an open command, app, link or hook consumes it.
# Start the sessions first so a slow VCS host cannot delay Claude's launch.
if profile_uses_pr_url; then
    print_step 7 "Looking for an existing PR/MR ($VCS_PROVIDER)..."
    PR_URL=$(check_existing_pr "$CONFIG_PATH")
    if [[ -n "$PR_URL" ]]; then
        print_success "Found PR/MR: $PR_URL"
    else
        print_success "No PR/MR yet (the agent opens one at its first real commit)"
    fi
else
    print_step 7 "Skipping PR/MR lookup (no profile config uses PR_URL or MR_URL)"
fi

# Step 8: Run profile commands BEFORE opening apps (so xcodegen, etc. are ready)
print_step 8 "Running profile commands..."

run_configured_commands ".profiles.$SELECTED_PROFILE.commands" profile 'command %d' --no-header ||
    print_success "No commands configured in profile"

# Step 9: Open terminal
print_step 9 "Opening terminal..."
LAUNCHER_ARGS=(--worktree "$WORKTREE_PATH" --issue-key "$ISSUE_KEY" --repo-name "$REPO_NAME" --companion-command "$COMPANION_COMMAND")
if [[ "$SKIP_PERMISSIONS" == "true" ]]; then
    LAUNCHER_ARGS+=(--skip-permissions)
fi
LAUNCHER_ARGS+=("${AGENT_FLAG_ARGS[@]}")

# In resume mode, start the agent without any prompt; otherwise use configured init command
if [[ "$RESUME_MODE" == true ]]; then
    AGENT_PROMPT=""
    OPEN_DESCRIPTION="resume mode"
elif [[ -n "$INIT_CMD" ]]; then
    AGENT_PROMPT="$INIT_CMD $ISSUE_KEY"
    OPEN_DESCRIPTION="$INIT_CMD"
else
    AGENT_PROMPT="$ISSUE_KEY"
    OPEN_DESCRIPTION="issue key only"
fi

OPENED_APP=""
if [[ "$TERMINAL_APP" == "Ghostty" ]]; then
    GHOSTTY_ARGS=("${LAUNCHER_ARGS[@]}")
    if [[ -n "$GHOSTTY_WINDOW_ID" ]]; then
        GHOSTTY_ARGS+=(--window-id "$GHOSTTY_WINDOW_ID")
    fi
    if "$SCRIPT_DIR/open-ghostty-agent.sh" "${GHOSTTY_ARGS[@]}" --prompt "$AGENT_PROMPT"; then
        OPENED_APP="Ghostty"
    else
        # Automation permission denied, a pre-1.3 Ghostty, or the AppleScript
        # preview API changed out from under us. Fall back rather than leave
        # the user with nothing opened.
        print_warning "Failed to open Ghostty tab, falling back to iTerm"
    fi
fi

if [[ -z "$OPENED_APP" && ("$TERMINAL_APP" == "iTerm" || "$TERMINAL_APP" == "Ghostty") ]]; then
    if "$SCRIPT_DIR/open-iterm-agent.sh" "${LAUNCHER_ARGS[@]}" --prompt "$AGENT_PROMPT"; then
        OPENED_APP="iTerm"
    fi
fi

# Last rung: tmux supplies the split instead of the terminal, so this reaches
# whatever app handles .command files and needs no per-terminal support. It is
# also the only path for a terminal.app naming something other than the two
# Pappardelle drives directly.
if [[ -z "$OPENED_APP" ]]; then
    if [[ "$TERMINAL_APP" != "iTerm" && "$TERMINAL_APP" != "Ghostty" ]]; then
        print_warning "Terminal '$TERMINAL_APP' is not driven directly; opening via the default terminal"
    fi
    if "$SCRIPT_DIR/open-default-terminal-agent.sh" "${LAUNCHER_ARGS[@]}" --prompt "$AGENT_PROMPT"; then
        OPENED_APP="The default terminal"
    fi
fi

if [[ -n "$OPENED_APP" ]]; then
    print_success "$OPENED_APP opened with the agent ($OPEN_DESCRIPTION)"
else
    print_warning "Failed to open a terminal with the agent"
    TERMINAL_OPEN_FAILED=true
fi

# Step 10: Open apps from profile
print_step 10 "Opening profile apps..."

config_records "[(.profiles.$SELECTED_PROFILE.apps // [])[] | [.name // \"\", .path // \"\", .command // \"\", .if_set // \"\"]]" ||
    error "Could not read profile apps from config"
if [[ -s "$CONFIG_RECORDS_PATH" ]]; then
    while IFS= read -r -u 3 -d '' APP_NAME &&
          IFS= read -r -u 3 -d '' APP_PATH_TMPL &&
          IFS= read -r -u 3 -d '' APP_CMD_TMPL &&
          IFS= read -r -u 3 -d '' APP_IF_SET; do

        # Check if_set condition
        if ! var_is_set "$APP_IF_SET"; then
            log "  Skipping app '$APP_NAME' (if_set '$APP_IF_SET' not set)"
            continue
        fi

        APP_PATH=$(expand_var "$APP_PATH_TMPL")
        APP_CMD=$(expand_var "$APP_CMD_TMPL")

        if [[ -n "$APP_CMD" ]]; then
            eval "$APP_CMD" 3<&- || print_warning "Failed: $APP_NAME"
            print_success "$APP_NAME opened (command)"
        elif [[ "$APP_NAME" == "Cursor" ]]; then
            cursor "$APP_PATH" 3<&- || print_warning "Failed to open Cursor"
            print_success "Cursor opened"
        elif [[ "$APP_NAME" == "Xcode" ]]; then
            if [[ -n "$APP_PATH" && -d "$APP_PATH" ]]; then
                open "$APP_PATH" 3<&-
                print_success "Xcode opened"
            else
                log "  Skipping Xcode (path not found: $APP_PATH)"
            fi
        else
            if [[ -n "$APP_PATH" ]]; then
                open -a "$APP_NAME" "$APP_PATH" 3<&- || print_warning "Failed to open $APP_NAME"
            else
                open -a "$APP_NAME" 3<&- || print_warning "Failed to open $APP_NAME"
            fi
            print_success "$APP_NAME opened"
        fi
    done 3< "$CONFIG_RECORDS_PATH"
else
    print_success "No apps configured in profile"
fi

# Step 11: Open links from profile
print_step 11 "Opening profile links..."

config_records "[(.profiles.$SELECTED_PROFILE.links // [])[] | [.url // \"\", .title // \"\", .if_set // \"\"]]" ||
    error "Could not read profile links from config"
if [[ -s "$CONFIG_RECORDS_PATH" ]]; then
    LINK_URLS=()
    while IFS= read -r -u 3 -d '' LINK_URL_TMPL &&
          IFS= read -r -u 3 -d '' LINK_TITLE &&
          IFS= read -r -u 3 -d '' LINK_IF_SET; do

        if ! var_is_set "$LINK_IF_SET"; then
            log "  Skipping link '$LINK_TITLE' (if_set '$LINK_IF_SET' not set)"
            continue
        fi

        LINK_URL=$(expand_var "$LINK_URL_TMPL")
        if [[ -n "$LINK_URL" ]]; then
            LINK_URLS+=("$LINK_URL")
            log "  Link: $LINK_TITLE -> $LINK_URL"
        fi
    done 3< "$CONFIG_RECORDS_PATH"

    if [[ ${#LINK_URLS[@]} -gt 0 ]]; then
        open "${LINK_URLS[@]}" || print_warning "Failed to open some links"
        print_success "Opened ${#LINK_URLS[@]} link(s) in browser"
    else
        print_success "No links to open (all filtered by if_set)"
    fi
else
    print_success "No links configured in profile"
fi

# Global post_workspace_create hooks (run after everything is open so windows exist)
config_records "[(.hooks.post_workspace_create // [])[] | [.name // \"\", .run // \"\", .continue_on_error // false, .background // false]]" ||
    error "Could not read post_workspace_create hooks from config"
if [[ -s "$CONFIG_RECORDS_PATH" ]]; then
    log "Running post_workspace_create hook(s)..."
    i=0
    while IFS= read -r -u 3 -d '' HOOK_NAME &&
          IFS= read -r -u 3 -d '' HOOK_RUN &&
          IFS= read -r -u 3 -d '' HOOK_CONTINUE &&
          IFS= read -r -u 3 -d '' HOOK_BG; do
        HOOK_NAME="${HOOK_NAME:-hook $i}"

        HOOK_RUN=$(expand_var "$HOOK_RUN")

        if [[ -n "$HOOK_RUN" ]]; then
            log "  Hook: $HOOK_NAME -> $HOOK_RUN"
            if [[ "$HOOK_BG" == "true" ]]; then
                eval "$HOOK_RUN" 3<&- >>"$LOG_FILE" 2>&1 </dev/null &
            elif [[ "$HOOK_CONTINUE" == "true" ]]; then
                eval "$HOOK_RUN" 3<&- || print_warning "Hook '$HOOK_NAME' failed (continuing)"
            else
                eval "$HOOK_RUN" 3<&- || { log "Hook '$HOOK_NAME' failed — aborting workspace setup"; exit 1; }
            fi
        fi
        i=$((i + 1))
    done 3< "$CONFIG_RECORDS_PATH"
fi

fi # end of OPEN_WORKSPACE check

# Final summary
echo ""
echo "============================================"
echo -e "${GREEN}Workspace $ISSUE_KEY is ready!${NC}"
echo "============================================"
echo ""
echo "Issue:     $ISSUE_URL"
echo "Title:     $TITLE"
echo "Profile:   $(get_profile_display_name "$SELECTED_PROFILE")"
if [[ -n "$PR_URL" ]]; then
    echo "PR:        $PR_URL"
fi
echo "Worktree:  $WORKTREE_PATH"
echo ""
if tmux -L "$PAPPARDELLE_TMUX_SOCKET" has-session -t "=$AGENT_SESSION_NAME:" 2>/dev/null; then
    if [[ "$RESUME_MODE" == true ]]; then
        echo "Agent session ready (resume mode)."
    elif [[ -n "$INIT_CMD" ]]; then
        echo "Agent session ready with $INIT_CMD."
    else
        echo "Agent session ready: $AGENT_SESSION_NAME"
    fi
else
    echo "Warning: agent session was not created."
fi
echo ""


log "=== $SCRIPT_NAME completed ==="

# handleOpenWorkspace() in source/app.tsx keys its "Opened"/"Open failed"
# header off this exit code, so a terminal that never opened must not exit 0.
if [[ "$TERMINAL_OPEN_FAILED" == true ]]; then
    exit 1
fi
